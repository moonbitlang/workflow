import {
  "moonbitlang/async@0.21.1",
  "moonbitlang/workflow@0.5.0",
  "moonbitlang/workflow@0.5.0/spawn",
}

///|
/// Structured disagreement: two advocate scouts argue OPPOSITE sides of a
/// real design question from code evidence, in parallel; a judge then
/// rules on their combined output. Because the judge's input EMBEDS the
/// advocates' answers, replay dependencies follow the data: edit one
/// advocate's brief and a re-run replays the untouched advocate, re-runs
/// the edited one, and re-runs the judge — nothing else.
///
///   moon run examples/debate.mbtx     (from the repo root)
///
/// Needs `openseek` on PATH and a provider key in the environment.
async fn main {
  debate() catch {
    error => println("workflow failed: \{error}")
  }
}

///|
let question : String = "Should the `spawn` sub-package stay a separate package whose only dependency edge points spawn -> workflow, or should its child-contract runner fold into the core `workflow` package?"

///|
async fn debate() -> Unit {
  let wf = @workflow.Workflow(
    runner=@spawn.contract_runner(launch=_ => {
      command: "openseek",
      args: ["subrun", "explore"],
      cwd: None,
      extra_env: None,
      deadline_ms: None,
    }),
    journal=@workflow.Journal::load("debate.jsonl"),
    max_concurrent=2,
  )

  // ---- Round 1: opposing advocates, in parallel ----
  wf.phase("Advocate")
  let briefs = [
    (
      "keep",
      "Argue FOR keeping spawn as a separate package over the core. Ground every point in concrete code. \{question}",
    ),
    (
      "fold",
      "Argue FOR folding the contract runner into the core package. Ground every point in concrete code. \{question}",
    ),
  ]
  let positions = @workflow.all_ok(
    @workflow.fan_out(briefs, brief => {
      let (side, prompt) = brief
      @workflow.attempt(() => wf.agent(
        prompt~,
        kind="explore",
        hints="spawn/contract.mbt runner.mbt moon.pkg spawn/moon.pkg",
        label="advocate:\{side}",
        max_steps=16,
      ))
    }),
  ) catch {
    error => {
      println("advocacy round failed: \{error}")
      return
    }
  }
  let keep_case = answer_of(positions[0])
  let fold_case = answer_of(positions[1])
  println("── KEEP  argues: \{clip(keep_case, 300)}…\n")
  println("── FOLD  argues: \{clip(fold_case, 300)}…\n")

  // ---- Round 2: the judge reads both and rules ----
  // The judge's input EMBEDS both cases: its replay identity now depends
  // on theirs, so an edited brief cascades exactly this far and no
  // further.
  wf.phase("Judge")
  let ruling = wf.agent(
    prompt="Two advocates examined: \{question} Rule which position the CODE better supports, in one paragraph ending with VERDICT: KEEP or VERDICT: FOLD. Verify their claims yourself before ruling.",
    kind="explore",
    hints="KEEP: \{clip(keep_case, 900)} ||| FOLD: \{clip(fold_case, 900)}",
    label="judge",
    max_steps=16,
  ) catch {
    error => {
      println("the judge failed: \{error}")
      return
    }
  }
  println("── RULING: \{answer_of(ruling)}\n")
  println(
    "\{wf.calls_made()} live, \{wf.calls_replayed()} replayed, \{wf.tokens_spent()} fresh tokens",
  )
}

///|
fn answer_of(report : Json) -> String {
  match report {
    { "answer": String(text), .. } => text
    other => other.stringify()
  }
}

///|
/// The head of a text, cut where a surrogate pair cannot be split: half
/// an emoji is neither readable output nor a prompt an engine can use.
fn clip(text : String, limit : Int) -> String {
  text.clamped_view(end=limit).to_owned()
}
